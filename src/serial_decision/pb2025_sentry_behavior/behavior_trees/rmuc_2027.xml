<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="go_home">
    <Sequence>
      <PubNav2Goal goal="{@home_goal}"
                   goal_out="{home_goal_pose}"
                   publish_if_changed="true"
                   topic_name="goal_pose"/>
      <WaitUntilReached robot_base_frame="gimbal_yaw_fake"
                        tolerance="0.15"
                        goal_pose="{home_goal_pose}"/>
      <PublishTwist v_y="0"
                    v_yaw="0"
                    v_x="0"
                    duration="0"
                    topic_name="cmd_vel"/>
      <KeepRunningUntilFailure>
        <AlwaysSuccess/>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="patrol">
    <Sequence>
      <Sequence>
        <PubNav2Goal goal="{@entry_goal}"
                     goal_out="{entry_goal_pose}"
                     publish_if_changed="true"
                     topic_name="goal_pose"/>
        <WaitUntilReached robot_base_frame="gimbal_yaw_fake"
                          tolerance="0.15"
                          goal_pose="{entry_goal_pose}"/>
      </Sequence>
      <LoadWaypoints total_waypoints="{total}"
                     wait_times="{wait_times}"
                     waypoints="{waypoints}"
                     frame_id="map"
                     waypoint_file="{@patrol_waypoint_file}"/>
      <Script code="wp_idx:=0"/>
      <KeepRunningUntilFailure>
        <ReactiveFallback>
          <ReactiveSequence>
            <IsInSemanticRegion/>
            <Sequence>
              <CalculateAttackPose costmap_port="{@nav_globalCostmap}"
                                   tracker_port="{@vision_string_data}"
                                   goal="{attack_pose}"
                                   vision_received_at="{@vision_received_at}"
                                   topic_name="debug_attack_pose"/>
              <PubNav2Goal goal="{attack_pose}"
                           goal_out="{goal_out}"
                           publish_if_changed="false"
                           topic_name="goal_pose"/>
            </Sequence>
          </ReactiveSequence>
          <Sequence>
            <GetCurrentWaypoint current_goal="{current_goal}"
                                current_wait_sec="{wait_sec}"
                                wp_idx="{wp_idx}"
                                wait_times="{wait_times}"
                                waypoints="{waypoints}"/>
            <Sequence>
              <PubNav2Goal goal="{current_goal}"
                           goal_out="{goal_out}"
                           publish_if_changed="true"
                           topic_name="goal_pose"/>
              <WaitUntilReached robot_base_frame="gimbal_yaw_fake"
                                tolerance="0.15"
                                goal_pose="{current_goal}"/>
            </Sequence>
            <PublishTwist v_y="0"
                          v_yaw="0"
                          v_x="0"
                          duration="0"
                          topic_name="cmd_vel"/>
            <WaitDuration duration_sec="{wait_sec}"/>
            <NextWaypoint loop="true"
                          total_waypoints="{total}"
                          wp_idx="{wp_idx}"/>
          </Sequence>
        </ReactiveFallback>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_2027">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <Fallback>
            <IsGameStatus max_remain_time="420"
                          min_remain_time="0"
                          expected_game_progress="4"
                          key_port="{@referee_gameStatus}"/>
            <ForceFailure>
              <PublishTwist v_y="0"
                            v_yaw="0"
                            v_x="0"
                            duration="0"
                            topic_name="cmd_vel"/>
            </ForceFailure>
          </Fallback>
          <ReactiveFallback>
            <ReactiveSequence>
              <IsStatusOK ammo_min="50"
                          hp_min="200"
                          key_port="{@referee_robotStatus}"/>
              <Fallback>
                <Inverter>
                  <IsRfidDetected ally_supply_point="true"
                                  key_port="{@referee_rfidStatus}"/>
                </Inverter>
                <IsStatusOK ammo_min="100"
                            hp_min="400"
                            key_port="{@referee_robotStatus}"/>
              </Fallback>
              <ManageSentryPosture mode="patrol"
                                   vision_received_at="{@vision_received_at}"
                                   vision_data="{@vision_string_data}"
                                   robot_status="{@referee_robotStatus}"/>
              <SubTree ID="patrol"
                       _autoremap="true"/>
            </ReactiveSequence>
            <ReactiveSequence>
              <IsRfidDetected ally_supply_point="true"
                              key_port="{@referee_rfidStatus}"/>
              <ManageSentryPosture mode="recovery"
                                   vision_received_at="{@vision_received_at}"
                                   vision_data="{@vision_string_data}"
                                   robot_status="{@referee_robotStatus}"/>
              <PublishTwist v_y="0"
                            v_yaw="0"
                            v_x="0"
                            duration="0"
                            topic_name="cmd_vel"/>
              <RetryUntilSuccess>
                <IsStatusOK ammo_min="100"
                            hp_min="400"
                            key_port="{@referee_robotStatus}"/>
              </RetryUntilSuccess>
            </ReactiveSequence>
            <ReactiveSequence>
              <ManageSentryPosture mode="recovery"
                                   vision_received_at="{@vision_received_at}"
                                   vision_data="{@vision_string_data}"
                                   robot_status="{@referee_robotStatus}"/>
              <SubTree ID="go_home"
                       _autoremap="true"/>
            </ReactiveSequence>
          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <BehaviorTree ID="test_action_goal">
    <SendNav2Goal goal="{@entry_goal}"
                  action_name="navigate_to_pose"/>
  </BehaviorTree>

  <BehaviorTree ID="test_topic_goal">
    <PubNav2Goal goal="{@entry_goal}"
                 goal_out="{goal_out}"
                 publish_if_changed="false"
                 topic_name="goal_pose"/>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="CalculateAttackPose">
      <input_port name="costmap_port"
                  default="{@nav_globalCostmap}"
                  type="nav_msgs::msg::OccupancyGrid_&lt;std::allocator&lt;void&gt; &gt;">GlobalCostmap port on blackboard</input_port>
      <input_port name="tracker_port"
                  default="{@vision_string_data}"
                  type="std_msgs::msg::String_&lt;std::allocator&lt;void&gt; &gt;">Vision target port on blackboard</input_port>
      <output_port name="goal"
                   default="{attack_pose}"
                   type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</output_port>
      <input_port name="vision_received_at"
                  default="{@vision_received_at}"
                  type="std::chrono::time_point&lt;std::chrono::_V2::steady_clock, std::chrono::duration&lt;long, std::ratio&lt;1l, 1000000000l&gt; &gt; &gt;">Vision receive time</input_port>
      <input_port name="topic_name"
                  default="__default__placeholder__"
                  type="std::string">Topic name</input_port>
    </Condition>
    <Action ID="GetCurrentWaypoint">
      <output_port name="current_goal"
                   type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">当前目标点</output_port>
      <output_port name="current_wait_sec"
                   type="double">当前航点的等待时间</output_port>
      <input_port name="wp_idx"
                  type="int">当前航点索引</input_port>
      <input_port name="wait_times"
                  type="std::vector&lt;double, std::allocator&lt;double&gt; &gt;">每个航点的等待时间列表</input_port>
      <input_port name="waypoints"
                  type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">航点列表</input_port>
    </Action>
    <Condition ID="IsGameStatus">
      <input_port name="max_remain_time"
                  default="420"
                  type="int">Maximum remaining time (s)</input_port>
      <input_port name="min_remain_time"
                  default="0"
                  type="int">Minimum remaining time (s)</input_port>
      <input_port name="expected_game_progress"
                  default="4"
                  type="int">Expected game progress stage</input_port>
      <input_port name="key_port"
                  default="{@referee_gameStatus}"
                  type="pb_rm_interfaces::msg::GameStatus_&lt;std::allocator&lt;void&gt; &gt;">GameStatus port on blackboard</input_port>
    </Condition>
    <Condition ID="IsInSemanticRegion"/>
    <Condition ID="IsRfidDetected">
      <input_port name="ally_supply_point"
                  default="true"
                  type="bool">己方补给点</input_port>
      <input_port name="key_port"
                  default="{@referee_rfidStatus}"
                  type="pb_rm_interfaces::msg::RfidStatus_&lt;std::allocator&lt;void&gt; &gt;">RfidStatus port on blackboard</input_port>
    </Condition>
    <Condition ID="IsStatusOK">
      <input_port name="ammo_min"
                  default="0"
                  type="int">Lower then minimum ammo will return FAILURE</input_port>
      <input_port name="hp_min"
                  default="300"
                  type="int">Minimum HP. NOTE: Sentry init/max HP is 400</input_port>
      <input_port name="key_port"
                  default="{@referee_robotStatus}"
                  type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;">RobotStatus port on blackboard</input_port>
    </Condition>
    <Action ID="LoadWaypoints">
      <output_port name="total_waypoints"
                   type="int">航点总数</output_port>
      <output_port name="wait_times"
                   type="std::vector&lt;double, std::allocator&lt;double&gt; &gt;">每个航点的等待时间 (秒)</output_port>
      <output_port name="waypoints"
                   type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">航点列表</output_port>
      <input_port name="frame_id"
                  default="map"
                  type="std::string">坐标系 ID</input_port>
      <input_port name="waypoint_file"
                  type="std::string">航点 CSV 文件的绝对路径</input_port>
    </Action>
    <Action ID="ManageSentryPosture">
      <input_port name="mode"
                  default="patrol"
                  type="std::string">patrol or recovery</input_port>
      <input_port name="vision_received_at"
                  default="{@vision_received_at}"
                  type="std::chrono::time_point&lt;std::chrono::_V2::steady_clock, std::chrono::duration&lt;long, std::ratio&lt;1l, 1000000000l&gt; &gt; &gt;">视觉消息接收时间</input_port>
      <input_port name="vision_data"
                  default="{@vision_string_data}"
                  type="std_msgs::msg::String_&lt;std::allocator&lt;void&gt; &gt;">视觉目标数据</input_port>
      <input_port name="robot_status"
                  default="{@referee_robotStatus}"
                  type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;">裁判系统机器人状态</input_port>
    </Action>
    <Action ID="NextWaypoint">
      <input_port name="loop"
                  default="true"
                  type="bool">循环航点列表</input_port>
      <input_port name="total_waypoints"
                  type="int">航点总数</input_port>
      <inout_port name="wp_idx"
                  type="int">当前航点索引</inout_port>
    </Action>
    <Condition ID="PubNav2Goal">
      <input_port name="goal"
                  default="0;0;0"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
      <output_port name="goal_out"
                   default="{goal_out}"
                   type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Published goal pose</output_port>
      <input_port name="publish_if_changed"
                  default="false"
                  type="bool">Only publish when goal pose changes</input_port>
      <input_port name="topic_name"
                  default="__default__placeholder__"
                  type="std::string">Topic name</input_port>
    </Condition>
    <Action ID="PublishTwist">
      <input_port name="v_y"
                  default="0.000000"
                  type="double">Linear Y velocity (m/s)</input_port>
      <input_port name="v_yaw"
                  default="0.000000"
                  type="double">Angular Z velocity (rad/s)</input_port>
      <input_port name="v_x"
                  default="0.000000"
                  type="double">Linear X velocity (m/s)</input_port>
      <input_port name="duration"
                  type="std::chrono::milliseconds">Publish then sleep duration in milliseconds</input_port>
      <input_port name="topic_name"
                  default="__default__placeholder__"
                  type="std::string">Topic name</input_port>
    </Action>
    <Decorator ID="RetryUntilSuccess"/>
    <Action ID="SendNav2Goal">
      <input_port name="goal"
                  default="0;0;0"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
      <input_port name="action_name"
                  type="std::string">Action server name</input_port>
    </Action>
    <Action ID="WaitDuration">
      <input_port name="duration_sec"
                  default="5.000000"
                  type="double">等待时长 (秒), 0 则跳过</input_port>
    </Action>
    <Action ID="WaitUntilReached">
      <input_port name="robot_base_frame"
                  default="gimbal_yaw_fake"
                  type="std::string">机器人基座坐标系</input_port>
      <input_port name="tolerance"
                  default="0.500000"
                  type="double">到达判定距离阈值 (m)</input_port>
      <input_port name="goal_pose"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">目标位姿</input_port>
    </Action>
  </TreeNodesModel>

</root>
