<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Project">
    <include path="models.xml"/>
    <include path="rmuc_2027.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Condition ID="CalculateAttackPose">
            <input_port name="costmap_port" default="{@nav_globalCostmap}" type="nav_msgs::msg::OccupancyGrid_&lt;std::allocator&lt;void&gt; &gt;">GlobalCostmap port on blackboard</input_port>
            <input_port name="tracker_port" default="{@vision_string_data}" type="std_msgs::msg::String_&lt;std::allocator&lt;void&gt; &gt;">Vision target port on blackboard</input_port>
            <output_port name="goal" default="{attack_pose}" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</output_port>
            <input_port name="vision_received_at" default="{@vision_received_at}" type="std::chrono::time_point&lt;std::chrono::_V2::steady_clock, std::chrono::duration&lt;long, std::ratio&lt;1l, 1000000000l&gt; &gt; &gt;">Vision receive time</input_port>
            <input_port name="topic_name" default="__default__placeholder__" type="std::string">Topic name</input_port>
        </Condition>
        <Decorator ID="DelayAfterSuccess">
            <input_port name="delay_ms" default="1000" type="int">Delay after success (ms)</input_port>
        </Decorator>
        <Action ID="GetCurrentWaypoint">
            <output_port name="current_goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">当前目标点</output_port>
            <output_port name="current_wait_sec" type="double">当前航点的等待时间</output_port>
            <input_port name="wp_idx" type="int">当前航点索引</input_port>
            <input_port name="wait_times" type="std::vector&lt;double, std::allocator&lt;double&gt; &gt;">每个航点的等待时间列表</input_port>
            <input_port name="waypoints" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">航点列表</input_port>
        </Action>
        <Condition ID="IsAttacked">
            <input_port name="vision_data" default="{@vision_string_data}" type="std_msgs::msg::String_&lt;std::allocator&lt;void&gt; &gt;">Vision string data port on blackboard</input_port>
            <input_port name="key_port" default="{@referee_robotStatus}" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;">RobotStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsCmdVelZero">
            <input_port name="linear_threshold" default="0.050000" type="double">Threshold below which linear velocity (vx/vy) is considered zero</input_port>
            <input_port name="cmd_vel" default="{@cmd_vel}" type="geometry_msgs::msg::Twist_&lt;std::allocator&lt;void&gt; &gt;">The cmd_vel command from controller or behavior tree output</input_port>
        </Condition>
        <Condition ID="IsDetectEnemy">
            <input_port name="key_port" default="{@vision_string_data}" type="std_msgs::msg::String_&lt;std::allocator&lt;void&gt; &gt;">Vision string data port on blackboard</input_port>
        </Condition>
        <Condition ID="IsEnemyInRange">
            <input_port name="max_distance" default="5.000000" type="double">Maximum engagement distance (meters)</input_port>
            <input_port name="key_port" default="{@vision_string_data}" type="std_msgs::msg::String_&lt;std::allocator&lt;void&gt; &gt;">Vision string data port on blackboard</input_port>
        </Condition>
        <Condition ID="IsFlagSet">
            <input_port name="flag_name" type="std::string">黑板上要检查的 int 标志名</input_port>
        </Condition>
        <Condition ID="IsGameStatus">
            <input_port name="max_remain_time" default="420" type="int">Maximum remaining time (s)</input_port>
            <input_port name="min_remain_time" default="0" type="int">Minimum remaining time (s)</input_port>
            <input_port name="expected_game_progress" default="4" type="int">Expected game progress stage</input_port>
            <input_port name="key_port" default="{@referee_gameStatus}" type="pb_rm_interfaces::msg::GameStatus_&lt;std::allocator&lt;void&gt; &gt;">GameStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsGoalReached">
            <input_port name="goal_in" default="{goal_out}" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Goal from blackboard</input_port>
            <input_port name="xy_tolerance" default="0.300000" type="double">XY tolerance in meters to consider goal reached</input_port>
            <input_port name="robot_base_frame" default="gimbal_yaw_fake" type="std::string">Robot base frame for TF lookup</input_port>
            <input_port name="global_frame" default="map" type="std::string">Global frame for TF lookup</input_port>
        </Condition>
        <Condition ID="IsInSemanticRegion"/>
        <Condition ID="IsLastWaypoint">
            <input_port name="total_waypoints" type="int">航点总数</input_port>
            <input_port name="wp_idx" type="int">当前航点索引</input_port>
        </Condition>
        <Condition ID="IsPowerPostureAvailable">
            <input_port name="hp_threshold" default="100" type="unsigned short">HP threshold for PowerDefense (only used when type=5)</input_port>
            <input_port name="key_port" default="{@referee_robotStatus}" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;">RobotStatus port on blackboard</input_port>
            <input_port name="type" type="unsigned char">Reinforcement posture type: 4=PowerAttack, 5=PowerDefense, 6=PowerMove</input_port>
        </Condition>
        <Condition ID="IsRfidDetected">
            <input_port name="ally_supply_point" default="true" type="bool">己方补给点</input_port>
            <input_port name="key_port" default="{@referee_rfidStatus}" type="pb_rm_interfaces::msg::RfidStatus_&lt;std::allocator&lt;void&gt; &gt;">RfidStatus port on blackboard</input_port>
        </Condition>
        <Condition ID="IsStatusOK">
            <input_port name="ammo_min" default="0" type="int">Lower then minimum ammo will return FAILURE</input_port>
            <input_port name="hp_min" default="300" type="int">Minimum HP. NOTE: Sentry init/max HP is 400</input_port>
            <input_port name="key_port" default="{@referee_robotStatus}" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;">RobotStatus port on blackboard</input_port>
        </Condition>
        <Action ID="LoadWaypoints">
            <output_port name="total_waypoints" type="int">航点总数</output_port>
            <output_port name="wait_times" type="std::vector&lt;double, std::allocator&lt;double&gt; &gt;">每个航点的等待时间 (秒)</output_port>
            <output_port name="waypoints" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">航点列表</output_port>
            <input_port name="frame_id" default="map" type="std::string">坐标系 ID</input_port>
            <input_port name="waypoint_file" type="std::string">航点 CSV 文件的绝对路径</input_port>
        </Action>
        <Action ID="ManageSentryPosture">
            <input_port name="mode" default="patrol" type="std::string">patrol or recovery</input_port>
            <input_port name="vision_received_at" default="{@vision_received_at}" type="std::chrono::time_point&lt;std::chrono::_V2::steady_clock, std::chrono::duration&lt;long, std::ratio&lt;1l, 1000000000l&gt; &gt; &gt;">视觉消息接收时间</input_port>
            <input_port name="vision_data" default="{@vision_string_data}" type="std_msgs::msg::String_&lt;std::allocator&lt;void&gt; &gt;">视觉目标数据</input_port>
            <input_port name="robot_status" default="{@referee_robotStatus}" type="pb_rm_interfaces::msg::RobotStatus_&lt;std::allocator&lt;void&gt; &gt;">裁判系统机器人状态</input_port>
        </Action>
        <Action ID="NextWaypoint">
            <input_port name="loop" default="true" type="bool">循环航点列表</input_port>
            <input_port name="total_waypoints" type="int">航点总数</input_port>
            <inout_port name="wp_idx" type="int">当前航点索引</inout_port>
        </Action>
        <Condition ID="PubNav2Goal">
            <input_port name="goal" default="0;0;0" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
            <output_port name="goal_out" default="{goal_out}" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Published goal pose</output_port>
            <input_port name="publish_if_changed" default="false" type="bool">Only publish when goal pose changes</input_port>
            <input_port name="topic_name" default="__default__placeholder__" type="std::string">Topic name</input_port>
        </Condition>
        <Action ID="PublishCmdVel">
            <input_port name="v_y" default="0.000000" type="double">Linear Y velocity (m/s)</input_port>
            <input_port name="v_yaw" default="0.000000" type="double">Angular Z velocity (rad/s)</input_port>
            <input_port name="wp_idx" type="int">当前航点索引</input_port>
            <input_port name="total_waypoints" type="int">航点总数</input_port>
            <input_port name="v_x" default="0.000000" type="double">Linear X velocity (m/s)</input_port>
            <input_port name="duration" type="std::chrono::milliseconds">Publish then sleep duration in milliseconds</input_port>
            <input_port name="topic_name" default="__default__placeholder__" type="std::string">Topic name</input_port>
        </Action>
        <Action ID="PublishSpinSpeed">
            <input_port name="spin_speed" default="0.000000" type="double">Angular Z velocity (rad/s)</input_port>
            <input_port name="duration" type="std::chrono::milliseconds">Publish then sleep duration in milliseconds</input_port>
            <input_port name="topic_name" default="__default__placeholder__" type="std::string">Topic name</input_port>
        </Action>
        <Action ID="PublishTwist">
            <input_port name="v_y" default="0.000000" type="double">Linear Y velocity (m/s)</input_port>
            <input_port name="v_yaw" default="0.000000" type="double">Angular Z velocity (rad/s)</input_port>
            <input_port name="v_x" default="0.000000" type="double">Linear X velocity (m/s)</input_port>
            <input_port name="duration" type="std::chrono::milliseconds">Publish then sleep duration in milliseconds</input_port>
            <input_port name="topic_name" default="__default__placeholder__" type="std::string">Topic name</input_port>
        </Action>
        <Decorator ID="RateController">
            <input_port name="hz" default="10.000000" type="double">Rate</input_port>
        </Decorator>
        <Control ID="RecoveryNode">
            <input_port name="num_attempts" default="999" type="int">Number of retries</input_port>
        </Control>
        <Decorator ID="RetryUntilSuccess"/>
        <Action ID="SendNav2Goal">
            <input_port name="goal" default="0;0;0" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
            <input_port name="action_name" type="std::string">Action server name</input_port>
        </Action>
        <Condition ID="SwitchSentryPosture">
            <input_port name="target_posture" type="unsigned char">Target posture ID </input_port>
            <input_port name="topic_name" default="__default__placeholder__" type="std::string">Topic name</input_port>
        </Condition>
        <Decorator ID="TickAfterTimeout">
            <input_port name="timeout" type="float">time in s to wait before ticking child again</input_port>
        </Decorator>
        <Action ID="WaitDuration">
            <input_port name="duration_sec" default="5.000000" type="double">等待时长 (秒), 0 则跳过</input_port>
        </Action>
        <Action ID="WaitUntilReached">
            <input_port name="robot_base_frame" default="gimbal_yaw_fake" type="std::string">机器人基座坐标系</input_port>
            <input_port name="tolerance" default="0.500000" type="double">到达判定距离阈值 (m)</input_port>
            <input_port name="goal_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">目标位姿</input_port>
        </Action>
    </TreeNodesModel>
</root>
