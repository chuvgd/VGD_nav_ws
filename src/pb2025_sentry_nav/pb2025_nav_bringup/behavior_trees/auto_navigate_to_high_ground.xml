<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- 主恢复节点，最多重试3次 -->
    <RecoveryNode number_of_retries="3" name="HighGroundNavigationRecovery">
      
      <!-- 主序列：前往高地 -->
      <Sequence name="NavigateToHighGroundSequence">
        
        <!-- 1. 等待导航系统就绪 -->
        <Wait wait_duration="2.0" name="WaitForNavSystem"/>
        
        <!-- 2. 创建高地目标点 -->
        <Script code="high_ground_goal" name="CreateHighGroundGoal">
          <Goal>
            <header>
              <frame_id>map</frame_id>
            </header>
            <pose>
              <position>
                <x>5.0</x>  <!-- 高地X坐标 -->
                <y>5.0</y>  <!-- 高地Y坐标 -->
                <z>0.0</z>
              </position>
              <orientation>
                <x>0.0</x>
                <y>0.0</y>
                <z>0.0</z>
                <w>1.0</w>
              </orientation>
            </pose>
          </Goal>
        </Script>
        
        <!-- 3. 发布高地目标到黑板 -->
        <SetBlackboard output_key="goal" value="{high_ground_goal}" name="SetHighGroundGoal"/>
        
        <!-- 4. 执行导航到目标点（带恢复机制） -->
        <RecoveryNode number_of_retries="2" name="NavigateToGoalRecovery">
          <PipelineSequence name="NavigatePipeline">
            <!-- 规划路径 -->
            <RateController hz="1.0">
              <Sequence>
                <GoalUpdated/>
                <ComputePathToPose path="{path}" planner_id="GridBased"/>
              </Sequence>
            </RateController>
            
            <!-- 跟随路径 -->
            <FollowPath path="{path}" controller_id="FollowPath"/>
          </PipelineSequence>
          
          <!-- 恢复行为 -->
          <ReactiveSequence name="RecoveryActions">
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait wait_duration="2"/>
          </ReactiveSequence>
        </RecoveryNode>
        
        <!-- 5. 到达后发布完成信号 -->
        <Action action="goal_reached" name="SignalArrival">
          <param name="topic_name">high_ground_arrived</param>
        </Action>
        
      </Sequence>
      
    </RecoveryNode>
  </BehaviorTree>
</root>