<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3" name="MainRecovery">
      
      <Sequence name="MainSequence">
        
        <!-- 读取参数中的高地坐标 -->
        <GetParam param_name="/high_ground/x" target="{high_ground_x}"/>
        <GetParam param_name="/high_ground/y" target="{high_ground_y}"/>
        <GetParam param_name="/high_ground/z" target="{high_ground_z}"/>
        <GetParam param_name="/high_ground/orientation_w" target="{high_ground_ow}"/>
        
        <!-- 创建目标点 -->
        <Script code="
          auto goal = std::make_shared&lt;geometry_msgs::msg::PoseStamped&gt;();
          goal->header.frame_id = &quot;map&quot;;
          goal->pose.position.x = high_ground_x;
          goal->pose.position.y = high_ground_y;
          goal->pose.position.z = high_ground_z;
          goal->pose.orientation.w = high_ground_ow;
          return goal;" 
          name="CreateGoalFromParams"/>
        
        <!-- 设置目标 -->
        <SetBlackboard output_key="goal" value="{goal}" name="SetGoal"/>
        
        <!-- 执行导航 -->
        <NavigateToPose goal="{goal}" server_name="bt_navigator"/>
        
      </Sequence>
      
    </RecoveryNode>
  </BehaviorTree>
</root>